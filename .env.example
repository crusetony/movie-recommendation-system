# TMDB application authentication (required)
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=zh-CN
TMDB_REGION=CN
TMDB_TIMEOUT_SECONDS=12

# Optional AI-enhanced query parsing
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=deepseek-flash

# Local services
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Optional local Chinese CLIP visual similarity (download explicitly first)
VISUAL_ENABLED=true
VISUAL_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
VISUAL_MODEL_VERSION=36e679e65c2a2fead755ae21162091293ad37834
VISUAL_DEVICE=auto
VISUAL_LOCAL_FILES_ONLY=true
VISUAL_MODEL_CACHE_DIR=./data/models
VISUAL_MAX_IMAGE_BYTES=5242880
VISUAL_POSTER_TIMEOUT_SECONDS=8

# Unified explainable fusion weights (must sum to 1)
SCORE_WEIGHT_HARD_CONSTRAINTS=0.25
SCORE_WEIGHT_TEXT_RELEVANCE=0.20
SCORE_WEIGHT_VISUAL_SIMILARITY=0.15
SCORE_WEIGHT_QUALITY=0.15
SCORE_WEIGHT_POPULARITY=0.10
SCORE_WEIGHT_USER_FEEDBACK=0.15
SCORE_HARD_FILTER_ENABLED=true

# MMR diversity reranking (pairwise weights must sum to 1)
MMR_ENABLED=true
MMR_LAMBDA=0.75
MMR_WEIGHT_TEXT_VECTOR=0.35
MMR_WEIGHT_VISUAL_VECTOR=0.20
MMR_WEIGHT_GENRES=0.20
MMR_WEIGHT_COUNTRIES=0.05
MMR_WEIGHT_YEAR=0.08
MMR_WEIGHT_COLLECTION=0.07
MMR_WEIGHT_DIRECTOR=0.05
